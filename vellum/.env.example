DATABASE_URL="file:../data/app.db"
# Shared login password (required)
APP_PASSWORD="change-me"
# 32+ char signing secret for session cookies (required)
SESSION_SECRET="generate-a-random-64-hex-string"
# Optional URL prefix, e.g. /vellum, for serving Vellum under a path on another
# origin. Build-time: change it and rebuild. Empty = today's behaviour.
NEXT_PUBLIC_BASE_PATH=
