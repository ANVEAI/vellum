DATABASE_URL="file:../data/app.db"
# Shared login password (required)
APP_PASSWORD="change-me"
# 32+ char signing secret for session cookies (required)
SESSION_SECRET="generate-a-random-64-hex-string"
# Empty by default; set to /vellum when serving behind ANVE, then rebuild (build-time).
NEXT_PUBLIC_BASE_PATH=
# Bare origin the exporter navigates to; IPv4 is pinned because the server binds -H 127.0.0.1 and Windows may resolve localhost to ::1, which breaks exports.
APP_ORIGIN=http://127.0.0.1:3210
# Optional: serve the language model from an OpenAI-compatible server instead of
# Ollama - e.g. ANVE's gateway, which logs every call. Set in .env only: the key
# never goes in the settings table. Unset LLM_BASE_URL to go back to Ollama.
LLM_BASE_URL=
LLM_API_KEY=
# "default" is the gateway's default model.
LLM_MODEL=default
LLM_MAX_TOKENS=16384
