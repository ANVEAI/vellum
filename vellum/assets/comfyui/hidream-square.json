{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model" },
    "inputs": { "unet_name": "hidream_i1_dev_fp8.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "QuadrupleCLIPLoader",
    "_meta": { "title": "Load CLIP (Quadruple)" },
    "inputs": {
      "clip_name1": "clip_l_hidream.safetensors",
      "clip_name2": "clip_g_hidream.safetensors",
      "clip_name3": "t5xxl_fp8_e4m3fn_scaled.safetensors",
      "clip_name4": "llama_3.1_8b_instruct_fp8_scaled.safetensors"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" },
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "ModelSamplingSD3" },
    "inputs": { "shift": 6.0, "model": ["1", 0] }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Input Prompt" },
    "inputs": { "text": "placeholder prompt", "clip": ["2", 0] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative" },
    "inputs": { "text": "bad ugly jpeg artifacts", "clip": ["2", 0] }
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "Latent 1024x1024" },
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "seed": 0,
      "steps": 28,
      "cfg": 1.0,
      "sampler_name": "lcm",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["4", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0]
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": { "images": ["9", 0], "filename_prefix": "vellum" }
  }
}
