# Vellum MCP server configuration.
#
# Copy to .env and fill in. Only VELLUM_APP_PASSWORD is required; everything
# else has a working default. The server validates all of this at boot and
# exits 78 with every problem listed at once rather than one per restart.

# --- Vellum target -----------------------------------------------------------
VELLUM_BASE_URL=http://localhost:3210
# Vellum's shared login password (APP_PASSWORD in vellum/.env).
# This is a secret: it is never sent to a model, never returned by a tool, and
# never logged. A wrong value trips a permanent circuit breaker rather than
# retrying, because Vellum rate-limits FAILED logins 5/min per IP against a
# bucket shared with its own web UI.
VELLUM_APP_PASSWORD=

# --- Transport ---------------------------------------------------------------
# stdio for local MCP clients; http for remote (Streamable HTTP, stateless).
# Overridable per-launch with --transport=stdio|http.
VELLUM_MCP_TRANSPORT=stdio
VELLUM_MCP_HTTP_HOST=127.0.0.1
VELLUM_MCP_HTTP_PORT=8080

# --- Inbound auth ------------------------------------------------------------
# OFF by default. With this off, anything that can reach the port has full
# read/write access to the Vellum library, including delete. Only run on a
# network you trust.
VELLUM_MCP_REQUIRE_AUTH=false
VELLUM_MCP_AUTH_TOKENS=

# --- Timeouts ----------------------------------------------------------------
VELLUM_MCP_REQUEST_TIMEOUT_MS=60000
# Vellum imposes NO server-side timeout on generation, and Ollama has none
# either. This is the only thing that will ever end a wedged run — and the
# abort it triggers is what releases Vellum's process-global generation lock.
VELLUM_MCP_GENERATION_TIMEOUT_MS=900000
# Vellum's export route caps itself at maxDuration=300s; leave headroom.
VELLUM_MCP_EXPORT_TIMEOUT_MS=300000

# --- Job registry ------------------------------------------------------------
VELLUM_MCP_JOB_TTL_MS=3600000
VELLUM_MCP_MAX_JOBS=200

# --- Serialization -----------------------------------------------------------
# Vellum runs ONE generation at a time, process-wide. These bound the queue this
# server keeps in front of it, so callers get an actionable error instead of
# hanging forever.
VELLUM_MCP_QUEUE_DEPTH=8
VELLUM_MCP_QUEUE_WAIT_MS=600000

# --- Export artifacts --------------------------------------------------------
# Exports are written here and the tool returns a path; bytes are never inlined
# (a real PPTX measured 23 MB).
VELLUM_MCP_EXPORT_DIR=./.exports
VELLUM_MCP_ARTIFACT_TTL_MS=86400000
VELLUM_MCP_ARTIFACT_MAX_BYTES=2000000000

# Origin used to build export resource_link URIs. MUST match the origin the
# consuming platform registered — hosts refuse to fetch a server-supplied URL
# from anywhere else, because that is an SSRF vector. Defaults to
# http://{VELLUM_MCP_HTTP_HOST}:{VELLUM_MCP_HTTP_PORT}, which is correct
# whenever the consumer registered this server's own address. Set it explicitly
# if you sit behind a proxy or a different external hostname.
# VELLUM_MCP_PUBLIC_URL=http://127.0.0.1:8765

# Exports at or below this size are embedded base64 in the tool result; larger
# ones come back as a resource_link. Base64 inflates ~33%.
VELLUM_MCP_EMBED_MAX_BYTES=5000000

# --- Logging -----------------------------------------------------------------
# Always written to stderr — stdout is the MCP protocol channel in stdio mode.
VELLUM_MCP_LOG_LEVEL=info
