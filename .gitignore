# ---------------------------------------------------------------------------
# Upstream projects. These are clones of other people's repositories (25 GB
# together, 17 GB of it ComfyUI model weights). They are fetched by
# scripts/setup-dependencies.ps1 rather than vendored here — committing them
# would republish their code under this repo and blow past GitHub's limits.
# ---------------------------------------------------------------------------
/ComfyUI/
/presenton/
/presentation-ai/
/searxng/

# ---------------------------------------------------------------------------
# Secrets. Never commit. vellum/.env.example documents what to set.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Generated / machine-local
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo

# Generated content: the SQLite database, generated images, exports, and the
# icon embedding index. All reproducible; none of it belongs in source control.
/vellum/data/

# Python environments (SearXNG / ComfyUI helpers)
.venv/
__pycache__/
*.pyc

# Local agent/editor state — machine-specific, not project configuration.
.claude/settings.local.json
.claude/*.lock

# OS / editor
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
